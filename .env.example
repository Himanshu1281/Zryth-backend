# PRODUCTION (aicalling.wrytflow.com). Copy to /opt/zryth-backend/.env on the server.
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://zryth-dashboard.netlify.app
# Zryth staff: get /api/admin (templates, prompts, tools, org number limits)
ADMIN_EMAILS=

# --- Supabase (service key: server only, never in the dashboard) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
KNOWLEDGE_BUCKET=knowledge_base

# --- Voice agent webhook_server.py on the same host (private) ---
AGENT_BASE_URL=http://127.0.0.1:8090
# Must equal SUPABASE_WEBHOOK_SECRET in the agent's .env
AGENT_SHARED_SECRET=
# Template the admin pages edit by default
AGENT_ID=maya_v2

# --- Vobiz REST API: buy numbers, route them to our SIP trunk ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_TRUNK_ID=

# --- LiveKit: add each bought number to the inbound trunk's accepted numbers ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_INBOUND_TRUNK_ID=

COST_PER_MINUTE=0
